# Banco de Dados (Neon/Supabase — connection string com pooling)
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# NextAuth v5 — gere com: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# URL base da app (usada para montar return_to/realm do Steam OpenID)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Steam Web API (SERVER-ONLY — sem prefixo NEXT_PUBLIC_, nunca exposta ao client)
# Obtenha em: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=""
